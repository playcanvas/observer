{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "groupName": "all npm dependencies",
      "schedule": [
        "on monday at 10:00am"
      ]
    },
    {
      "matchDepTypes": ["devDependencies"],
      "rangeStrategy": "pin"
    },
    {
      "matchDepTypes": ["dependencies"],
      "rangeStrategy": "widen"
    },
    {
      "description": "Hold until eslint-plugin-react and eslint-plugin-jsx-a11y (via @playcanvas/eslint-config) support ESLint 10",
      "matchPackageNames": [
        "eslint"
      ],
      "allowedVersions": "<10.0.0"
    },
    {
      "description": "Hold until typedoc and typescript-eslint support TypeScript 7",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7.0.0"
    }
  ]
}
